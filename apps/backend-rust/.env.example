# ===== 服务配置 =====
HOST=127.0.0.1
# 5330 为 frontend（apps/web-react/vite.config.ts）默认代理目标；5320 属官方 backend-mock
PORT=5330

# ===== 数据库 =====
# SQLite（默认）：相对路径基于启动时的工作目录（apps/backend-rust）
DATABASE_URL=sqlite:./data/vben.db?mode=rwc
# Postgres（预留，需补对应 sqlx feature 与迁移脚本）
# DATABASE_URL=postgres://vben:vben@127.0.0.1:5432/vben

# ===== JWT =====
# 生产环境必须替换为足够长的随机值；短于 32 字符启动时会告警
JWT_SECRET=vben-admin-rust-secret-change-me
# accessToken 有效期（分钟）
JWT_ACCESS_TTL_MINUTES=120
# refreshToken 有效期（天）
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=vben-backend-rust
JWT_AUDIENCE=vben-admin

# ===== Cookie 与反向代理 =====
# HTTPS 部署应置 true
SECURE_COOKIES=false
# 仅在确实位于反向代理之后才置 true，否则可被伪造 X-Forwarded-For 绕过限流
TRUST_PROXY=false

# ===== 登录保护 =====
# 窗口内失败次数上限 / 统计窗口（分钟）/ 触发后的锁定时长（分钟）
LOGIN_MAX_FAIL=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# ===== 种子账号 =====
# 仅在建库时生效（表非空则跳过种子）。生产应改为强口令
# 未设置时代码内置默认值取自 db/seed.rs，与官方 backend-mock 一致
SEED_PASSWORD=123456

# ===== 跨域与静态托管 =====
CORS_ALLOWED_ORIGINS=http://localhost:5667,http://localhost:5666,http://127.0.0.1:5667
# 可选：指向 React 构建产物，配置后由后端直接托管 SPA
# SERVE_STATIC_DIR=../web-react/dist

# ===== 日志 =====
RUST_LOG=info,vben_backend_rust=debug
