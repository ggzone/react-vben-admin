# 服务配置
HOST=127.0.0.1
PORT=5320

# 数据库连接（SQLite；后续切换 Postgres 仅需改此连接串与 sqlx feature）
# SQLite: sqlite:./data/vben.db?mode=rwc
# Postgres(预留): postgres://vben:vben@127.0.0.1:5432/vben
DATABASE_URL=sqlite:./data/vben.db?mode=rwc

# JWT 密钥（生产环境必须修改）
JWT_SECRET=vben-admin-rust-secret-change-me

# accessToken 有效期（天）
JWT_ACCESS_EXPIRE_DAYS=7

# 跨域允许的来源（前端 dev 地址，多个用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5667,http://localhost:5666,http://127.0.0.1:5667

# 可选：静态资源目录（React 构建产物 dist），配置后后端可直接托管 SPA
# SERVE_STATIC_DIR=../web-react/dist

# 日志级别
RUST_LOG=info,vben_backend_rust=debug
